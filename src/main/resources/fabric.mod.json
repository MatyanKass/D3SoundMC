{
	"schemaVersion": 1,
	"id": "d3sound",
	"version": "${version}",
	"name": "D3Sound",
	"description": "Physically modelled sound for Minecraft: real propagation through world geometry, binaural localisation, diffraction, transmission through walls, structure-borne sound and reverberation measured from the room itself.",
	"authors": ["MatyanKass"],
	"contact": {
		"sources": "https://github.com/MatyanKass/D3SoundMC",
		"issues": "https://github.com/MatyanKass/D3SoundMC/issues"
	},
	"license": "MIT",
	"environment": "client",
	"entrypoints": {
		"client": [
			"dev.d3sound.mc.client.D3SoundClient"
		]
	},
	"mixins": [
		{
			"config": "d3sound.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.2",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}
